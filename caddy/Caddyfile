{
	admin 0.0.0.0:2019
	on_demand_tls {
		ask http://control-plane:8080/certificates/authorize
	}
}

:80 {
	log {
		output file /var/log/caddy/access.json
		format json
	}

	redir https://{http.request.host}{http.request.uri} permanent
}

:443 {
	tls {
		on_demand
	}

	log {
		output file /var/log/caddy/access.json
		format json
	}

	respond "No hay un servicio registrado para este dominio." 404
}
